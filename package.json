{
  "name": "qa-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node -v && prisma generate && vite build",
    "vercel-build": "node -v && prisma generate --schema=prisma/schema.vercel.prisma && prisma db push --schema=prisma/schema.vercel.prisma && vite build",
    "preview": "vite preview",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:generate:vercel": "prisma generate --schema=prisma/schema.vercel.prisma",
    "db:push": "prisma db push",
    "db:push:vercel": "prisma db push --schema=prisma/schema.vercel.prisma"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.3.0",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "@tailwindcss/vite": "^4.3.0",
    "svelte": "^4.2.18",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.20.0"
  }
}
